# Local cache / virtual environments
__pycache__/
*.py[cod]
.venv/
.vscode/
.idea/
# Generated design outputs
**/build/
**/out/
**/*-backups/
**/*.lck
**/*.kicad_prl
# Local proprietary or unapproved existing designs: never commit by default
/02_Design_Modification/original/
/02_Design_Modification/working/
# Preserve approved source CAD files and documented test results

# EasyEDA generated export data (design sources .eprj3/.esch2/.epcb2 are not excluded)
/01_New_Design/easyeda/exports/

# Local setup logs can contain user-specific paths
/.setup-local/

# Fixed local CAD review worktrees (each nested folder is its own Git worktree)
/workspaces/
